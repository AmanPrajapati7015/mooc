{
  "manifest_version": 3,
  "name": "NPTEL Quiz Interactivator",
  "version": "1.2",
  "description": "Automatically makes NPTEL quizzes interactive.",
  "content_scripts": [
    {
      "matches": ["https://onlinecourses.nptel.ac.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
